{
  "name": "brack-n-roll",
  "version": "3.0.0",
  "description": "Moteur algorithmique de tournoi modulaire (DAG) & Time Machine (Event Sourcing)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "npm run web:build:multi && npm run web:build:single",
    "web:build:multi": "vite build --config web/vite.config.ts",
    "web:build:single": "vite build --config web/vite.config.singlefile.ts",
    "web:preview": "vite preview --config web/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.1.8"
  }
}
